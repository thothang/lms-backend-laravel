# ==============================================
# LIBRARY MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ==============================================

APP_NAME="Library Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ==============================================
# DATABASE
# ==============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=library_management
DB_USERNAME=root
DB_PASSWORD=

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET=your-jwt-secret-key-here-generate-60-char-minimum
JWT_TTL=60
JWT_REFRESH_TTL=20160

# ==============================================
# SESSION
# ==============================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

# ==============================================
# MAIL CONFIGURATION (SMTP)
# ==============================================
# CHON 1 TRONG 3 MAIL DRIVER: smtp, mailgun, sendmail

# Option 1: SMTP (Gmail, Outlook, etc.)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@library.com"
MAIL_FROM_NAME="${APP_NAME}"

# Option 2: Sendmail (Linux server)
# MAIL_MAILER=sendmail
# MAIL_HOST=null
# MAIL_PORT=25
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null

# Option 3: Mailgun (https://www.mailgun.com)
# MAIL_MAILER=mailgun
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@your-domain.mailgun.org
# MAIL_PASSWORD=your-mailgun-password
# MAIL_ENCRYPTION=tls

# ==============================================
# FRONTEND URL
# ==============================================
FRONTEND_URL=http://localhost:5173
PUBLIC_CALLBACK_URL=http://localhost:5173

# ==============================================
# CORS (Comma-separated for multiple origins)
# ==============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================
# SEPAY PAYMENT GATEWAY
# ==============================================
# Sandbox: https://my.sepay.vn (test mode)
# Production: https://my.sepay.vn (live mode)

SEPAY_MERCHANT_ID=SP-TEST-your-merchant-id
SEPAY_SECRET_KEY=your-sepay-secret-key
SEPAY_ENV=sandbox

# IPN Callback URL (configure on SePay dashboard)
# https://your-domain.com/api/sepay/ipn

# ==============================================
# LIBRARY SETTINGS
# ==============================================
DEFAULT_DAILY_FEE=5000
DEPOSIT_PERCENT=50
MAX_DEPOSIT_AMOUNT=300000
MAX_BORROW_PER_USER=3
MAX_RENEW_COUNT=2
DEFAULT_BORROW_DAYS=9
OVERDUE_PENALTY_MULTIPLIER=1.5

# ==============================================
# FILESYSTEM
# ==============================================
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# ==============================================
# BROADCASTING
# ==============================================
BROADCAST_CONNECTION=log