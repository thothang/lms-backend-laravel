						"header": [],
						"url": {
							"raw": "{{baseUrl}}/profile",
							"host": ["{{baseUrl}}"],
							"path": ["profile"]
						},
						"description": "Test token cũ đã bị blacklist - PHẢI trả 401"
					}
				},
