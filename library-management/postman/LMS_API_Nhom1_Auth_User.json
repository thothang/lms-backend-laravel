							"host": ["{{baseUrl}}"],
							"path": ["logout"]
						},
						"description": "Đăng xuất - Token được thêm vào jwt_blacklist"
					}
				},
				{
					"name": "1.6 Test Token đã Logout (phải thất bại)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 401 Unauthorized - token đã bị blacklist', function() {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test('Token is blacklisted - returns proper error', function() {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.error).to.be.oneOf(['Token has been blacklisted', 'Token has expired', 'Unauthenticated', 'Token error']);",
									"});",
									"",
									"pm.test('Clear oldToken variable', function() {",
									"    pm.collectionVariables.set('oldToken', '');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{oldToken}}",
									"type": "string"
								}
							]
						},
