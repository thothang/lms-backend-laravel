{
	"info": {
		"name": "LMS API - Nhóm 5: Thủ thư (Librarian)",
		"description": "API Test Collection - Chức năng dành cho Thủ thư (Librarian)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "librarianToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. ĐĂNG NHẬP (Required)",
			"item": [
				{
					"name": "0.1 Đăng nhập Librarian",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Set librarianToken variable', function() {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('access_token');",
									"    pm.collectionVariables.set('librarianToken', jsonData.access_token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"librarian@library.com\",\n    \"password\": \"password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": ["{{baseUrl}}"],
							"path": ["login"]
						},
						"description": "Đăng nhập với tài khoản Librarian"
					}
				}
			]
		},
		{
			"name": "14. THỦ THƯ - QUẢN LÝ SÁCH",
			"item": [
				{
					"name": "14.1 Tạo đầu sách mới",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 or 422', function() {",
									"    var status = pm.response.code;",
									"    pm.expect([201, 422]).to.include(status);",
									"});",
									"",
									"pm.test('Response has book info or error', function() {",
									"    var jsonData = pm.response.json();",
									"    var hasValidResponse = jsonData.id || jsonData.book || jsonData.error;",
									"    pm.expect(hasValidResponse).to.exist;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{librarianToken}}",
