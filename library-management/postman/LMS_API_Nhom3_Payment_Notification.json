					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/notifications/1/read",
							"host": ["{{baseUrl}}"],
							"path": ["notifications", "1", "read"]
						},
						"description": "Đánh dấu thông báo đã đọc"
					}
				}
			]
		},
		{
			"name": "12. NHÓM TIN NHẮN (Message)",
